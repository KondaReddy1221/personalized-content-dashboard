{
  "name": "personalized-content-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-sqlite-dev.mjs",
    "dev:sqlite": "node scripts/run-sqlite-dev.mjs",
    "dev:neon": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/run-sqlite-tests.mjs",
    "test:watch": "node scripts/run-sqlite-tests.mjs --watch",
    "db:generate:sqlite": "node scripts/run-sqlite-prisma.mjs generate --schema prisma/schema.sqlite.prisma",
    "db:push:sqlite": "node scripts/run-sqlite-prisma.mjs db push --schema prisma/schema.sqlite.prisma",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@reduxjs/toolkit": "^2.13.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.14",
    "typescript": "^5"
  }
}
