# Default application database: Neon PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NEXT_PUBLIC_NEWS_API_KEY=""
NEXT_PUBLIC_TMDB_API_KEY=""

# SQLite is used only by the explicit local SQLite commands. They set
# DATABASE_URL=file:./dev.db for their child processes and do not use DIRECT_URL.
