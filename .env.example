# Local development uses SQLite. These values are not for Vercel production.
DATABASE_URL="file:./dev.db"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NEXT_PUBLIC_NEWS_API_KEY=""
NEXT_PUBLIC_TMDB_API_KEY=""

# In Vercel, set these to Neon connection strings in Project Settings.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
